# Supabase Configuration
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to git - it contains sensitive credentials!

# Get these values from your Supabase project: https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
# OR use anon key instead:
# VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Sentry Error Tracking
# Get your DSN from: https://sentry.io/settings/projects/
VITE_SENTRY_DSN=

# ==============================================================================
# Blockchain & Web3 Configuration
# ==============================================================================
# SECURITY CRITICAL: Never commit these values! Keep them secret!
# These variables are used by Supabase Edge Functions for blockchain operations

# OmniLink EVM Private Key
# Used for signing blockchain transactions (e.g., minting NFTs)
# SECURITY: In production, inject via vault (e.g., AWS Secrets Manager, HashiCorp Vault)
#           NEVER hardcode a real private key in any file. The mainnet deploy guard
#           will reject the placeholder value below.
# Generate: Use a secure wallet or key generation tool
# Format: 64-character hex string (without 0x prefix) or with 0x prefix
WEB3_PRIVATE_KEY=your-private-key-here
# Required for mainnet deploys (safety gate — see scripts/hardhat/guard-mainnet-deploy.mjs)
# ALLOW_MAINNET_DEPLOY=false

# Alchemy API Keys for RPC Access
# Get from: https://dashboard.alchemy.com/
# Create separate apps for each network for better monitoring
ALCHEMY_API_KEY_ETH=your-ethereum-alchemy-key
ALCHEMY_API_KEY_POLYGON=your-polygon-alchemy-key

# APEXMembershipNFT Contract Address
# Deployed ERC721 contract address for premium membership NFTs
# Set after deploying the smart contract
# Format: Ethereum address (0x...)
MEMBERSHIP_NFT_ADDRESS=0x...

# Alchemy Webhook Signing Key
# Used to verify webhook requests from Alchemy are authentic
# Get from: Alchemy Dashboard > Webhooks > Your Webhook > Signing Key
ALCHEMY_WEBHOOK_SIGNING_KEY=your-webhook-signing-key

# Optional: Network Configuration
# Specify which network to use (mainnet, polygon, etc.)
# Default: polygon (for lower gas fees)
VITE_WEB3_NETWORK=polygon
VITE_ENABLE_WEB3=true

# ==============================================================================
# OAuth Provider Configuration
# ==============================================================================
# These secrets are configured in the Supabase Dashboard (Authentication > Providers)
# They are NOT exposed to the browser (no VITE_ prefix)

# Google OAuth
# Set up at: https://console.cloud.google.com/apis/credentials
# Create OAuth 2.0 Client ID (Web application type)
# Authorized redirect URI: https://rtopreovkywofgwgmozi.supabase.co/auth/v1/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Apple Sign In
# Set up at: https://developer.apple.com/account/resources/identifiers
# Service ID: com.apexomnihub.web.login
# Authorized redirect URI: https://rtopreovkywofgwgmozi.supabase.co/auth/v1/callback
APPLE_CLIENT_ID=com.apexomnihub.web.login
APPLE_CLIENT_SECRET=your-apple-client-secret-jwt
# The Apple client secret is a JWT generated from a .p8 private key
# Generate it with: npm run apple:secret
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id

# Orchestrator Configuration
# URL of the deployed Python Orchestrator service (server-side / edge functions)
ORCHESTRATOR_URL=https://apex-orchestrator-api.onrender.com

# Browser-facing orchestrator URL — used by the OmniBoard wizard
# (apps/omnihub-site/dashboard/components/...). This is a BUILD-TIME variable:
# Vite inlines it into the bundle at `bun run build`. For production it must be
# supplied to the BUILD step (GitHub repo Variable VITE_ORCHESTRATOR_URL, wired
# into release.yml / deploy-production-cf-direct.yml). NOTE: setting it in the
# Cloudflare Pages dashboard has NO effect on direct `wrangler pages deploy`
# uploads — only on CF-Pages-Git builds. If unset at build time the wizard
# falls back to its "contact your admin" error state.
VITE_ORCHESTRATOR_URL=https://apex-orchestrator-api.onrender.com

# CORS allowed origins for the orchestrator HTTP API (comma-separated)
# Only these origins can make credentialed requests to the orchestrator
CORS_ALLOWED_ORIGINS=https://apexomnihub.icu,https://www.apexomnihub.icu

# Supabase Edge Function base URL (for production email delivery, etc.)
SUPABASE_EDGE_FUNCTION_URL=https://your-project-id.supabase.co/functions/v1
SUPABASE_ANON_KEY=your-supabase-anon-key

# ==============================================================================
# OmniDash Configuration
# ==============================================================================
# Enable OmniDash executive dashboard (set to true for authorized admins)
VITE_OMNIDASH_ENABLED=true

# DEPRECATED: Email hints only, NOT used for auth. Admin access is determined
# exclusively by public.user_roles (via claim_admin_access RPC).
# See docs/guides/admin-secret-setup.md for how to bootstrap admin.
# VITE_OMNIDASH_ADMIN_EMAILS=admin@example.com

# ==============================================================================
# OmniLink Mobile PWA Configuration
# ==============================================================================
# Enable mobile-only gate (restricts desktop access)
# Set to false to allow desktop access for all users
VITE_OMNILINK_MOBILE_ONLY=true

# Enable PWA functionality (install prompt, offline support)
VITE_OMNILINK_PWA=true

# Enable voice agent features
VITE_OMNILINK_VOICE=true

# Enable translation features
VITE_OMNILINK_TRANSLATION=true

# ==============================================================================
# Vercel Deployment — set ALL vars below in Vercel > Settings > Environment Variables
# ==============================================================================
# Dashboard redirect URL after login. Keep a same-origin relative path so the
# OmniLink native shell deep-links into the internal /omnidash shell, not an
# external host. Defaults to /omnidash if not set.
VITE_DASHBOARD_URL=/omnidash

# ==============================================================================
# REQUIRED in Vercel for OmniDash to function:
# VITE_SUPABASE_URL          — Supabase project URL
# VITE_SUPABASE_PUBLISHABLE_KEY — Supabase anon/publishable key
# VITE_OMNIDASH_ENABLED       — set to: true
# VITE_OMNILINK_MOBILE_ONLY   — set to: false for desktop access
# VITE_OMNILINK_VOICE         — set to: true
# VITE_SENTRY_DSN             — optional, Sentry error tracking
# ==============================================================================

# Demo Mode (no Supabase credentials required)
# Set to true to use seeded demo data for sales demos and development
VITE_DEMO_MODE=false

# ==============================================================================
# USO (Universal Synchronized Orchestrator) Configuration
# ==============================================================================
# Full offline demo mode — bypasses ALL external network requests and hydrates
# the UI exclusively from a pristine, locally-cached temporal event log.
# Guarantees a flawless, zero-latency offline presentation.
VITE_OMNI_DEMO_MODE=false

# OmniBridge Enterprise Integration
# M2M client registry (JSON array), webhook signing secret, JWT secret
# OMNIBRIDGE_M2M_CLIENTS=[]
# OMNIBRIDGE_WEBHOOK_SECRET=your-webhook-signing-secret
# OMNIBRIDGE_JWT_SECRET=your-jwt-signing-secret
# OMNIBRIDGE_ALLOW_LEGACY_SINGLE_SECRET=false
# OMNIBRIDGE_SBBL_HQ_SECRET=sbbl-hq-signing-secret

# ------------------------------------------------------------------------------
# OmniBridge v1.6.0 — SBBL-HQ bidirectional integration
# ------------------------------------------------------------------------------
# Secret used to verify inbound SBBL-HQ native sync packets at
# /api/omnibridge/sync. MUST match what SBBL-HQ sets as OMNIHUB_SIGNING_SECRET
# in its Cloudflare Workers secrets. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# OMNIBRIDGE_SBBL_NATIVE_SECRET=

# Secret used to SIGN outbound control-plane commands to SBBL-HQ. MUST match
# what SBBL-HQ sets as OMNIHUB_VERIFY_KEY. Same generation command.
# CONTROL_SIGNING_SECRET_SBBL_HQ=

# Target URL for control-plane commands to SBBL-HQ's Cloudflare Worker.
# Production: https://sbbl-hq.icu/webhooks/omnihub
# CONTROL_TARGET_URL_SBBL_HQ=

# Registry example with sync_packet profile (add to OMNIBRIDGE_M2M_CLIENTS):
#   {
#     "client_id": "sbbl-hq-sync",
#     "client_secret_hash": "unused-for-sync-packet-profile",
#     "scopes": ["omnibridge:ingest"],
#     "tenant_id": "tenant_sbbl",
#     "webhook": {
#       "source_id": "sbbl-hq",
#       "key_id": "sbbl-hq-sync-v1",
#       "secret_env": "OMNIBRIDGE_SBBL_NATIVE_SECRET",
#       "status": "active",
#       "profile": "sync_packet",
#       "allowed_ips": []
#     }
#   }

# ==============================================================================
# CHRONOS Durable Coordination
# ==============================================================================
# Enable durable coordination locks and idempotency (default is Postgres adapter)
CHRONOS_ADAPTER=supabase
CHRONOS_LOCK_TTL_SECONDS=30
CHRONOS_IDEMPOTENCY_TTL_HOURS=24

# ==============================================================================
# BYOM Model Registry & AI Governance
# ==============================================================================
# Supported model providers registry. Configured in ModelProviderRegistry.
# Secret references should never be direct API keys here, but keys in the Vault.
BYOM_PII_REDACTION_ENABLED=true
BYOM_BUDGET_TENANT_MONTHLY_LIMIT=100.00
BYOM_DEFAULT_TIMEOUT_MS=15000

# ==============================================================================
# PhysiOmni Physical AI Safety
# ==============================================================================
PHYSIOMNI_DEMO_ENABLED=true
PHYSIOMNI_LIVE_ENABLED=false
PHYSIOMNI_PHYSICAL_ACTIONS_ENABLED=false
PHYSIOMNI_KILL_SWITCH_ACTIVE=false

# ==============================================================================
# RSI Governance
# ==============================================================================
# Safety model and deterministic parameters for recursive self-improvement gate
RSI_MODEL_ENABLED=false
RSI_MODEL_ENDPOINT=https://api.apexomnihub.icu/rsi
RSI_MODEL_API_KEY=your-rsi-model-api-key-here
RSI_POLICY_VERSION=1.0.0

# APEX OmniHub Edge Function Configuration
ALLOWED_ORIGINS="https://apexomnihub.icu,https://www.apexomnihub.icu,http://localhost:3000"

# ==============================================================================
# MCP Gateway — Remote MCP Server for Claude Connectors
# ==============================================================================
# Keys Claude sends as: Authorization: Bearer <key>. Each key carries scopes:
#   MCP_GATEWAY_WRITE_KEY - read + write scopes (db writes, github, cloudflare, omnihub writes)
#   MCP_GATEWAY_READ_KEY  - read scopes only
#   MCP_GATEWAY_API_KEY   - legacy shared key, read scopes only
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_GATEWAY_WRITE_KEY=your-mcp-gateway-write-key-here
MCP_GATEWAY_READ_KEY=your-mcp-gateway-read-key-here
MCP_GATEWAY_API_KEY=your-mcp-gateway-api-key-here

# GitHub Personal Access Token (needs repo + read:org scopes)
# Used by: github_list_repos, github_get_file, github_create_branch, etc.
GITHUB_TOKEN=your-github-pat-here

# Cloudflare API Token (needs Pages:Edit, Cache Purge, Workers:Read)
# Create at: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token-here

# Cloudflare Account ID (visible in the URL when logged in to Cloudflare)
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id-here

# Connector URL to paste into Claude → Customize → Connectors:
#   https://<your-project-id>.supabase.co/functions/v1/mcp-gateway
PHYSIOMNI_LIVE_ENABLED="false"
A L L O W E D _ O R I G I N S = h t t p s : / / a p e x o m n i h u b . i c u , h t t p s : / / w w w . a p e x o m n i h u b . i c u  
 P H Y S I O M N I _ L I V E _ E N A B L E D = t r u e  
 
# ── APEX-COMPRESS: Token Optimization ──────────────────────────────
APEX_COMPRESS_ENABLED=true
APEX_COMPRESS_CACHE_THRESHOLD=0.92